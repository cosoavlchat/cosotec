rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper de roles con custom claims
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isVendedor() {
      return hasRole('vendedor');
    }
    
    function isSoporte() {
      return hasRole('soporte');
    }

    // Catálogo de Productos
    match /products/{productId} {
      // Público puede leer productos activos; admin y vendedores pueden leer todo
      allow read: if (resource.data.activo == true) || isAdmin() || isVendedor() || isSoporte();
      // Solo el Administrador puede crear, editar o eliminar productos
      allow write: if isAdmin();
    }

    // Catálogo de Paquetes
    match /packages/{packageId} {
      allow read: if (resource.data.activo == true) || isAdmin() || isVendedor() || isSoporte();
      allow write: if isAdmin();
    }

    // Configuración de Precios y Reglas
    match /settings/pricing {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración de Contacto
    match /settings/contact {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Datos Bancarios SPEI (REGLA 7: NO ES DE LECTURA PÚBLICA)
    match /settings/bank {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Viáticos por Estado
    match /travelFees/{estadoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bitácora de Auditoría (Audit Log)
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Directorio de Usuarios
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // Contador atómico de folios
    match /counters/folios {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Bloqueo por defecto para cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
